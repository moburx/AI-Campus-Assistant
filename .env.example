# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요. (.env는 git에 올리지 않습니다)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI 기능 (선택 사항 — 비워 두면 규칙 기반 조언으로 동작)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 답변 속도를 위해 생각 단계를 줄임 (LOW 권장)
GEMINI_THINKING_LEVEL=LOW

# 이메일 (console = 터미널에 출력만, smtp = 실제 발송)
EMAIL_MODE=console
# Gmail 사용 시: 2단계 인증을 켠 뒤 "앱 비밀번호"(16자리)를 발급받아 넣으세요. 일반 비밀번호는 동작하지 않습니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=AI Campus Assistant

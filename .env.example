# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요. (.env는 git에 올리지 않습니다)
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI 기능 (선택 사항 — 비워 두면 규칙 기반 조언으로 동작)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# 무료 한도(모델별 하루 요청 수)를 다 쓰면 다음 모델로 자동 전환 (쉼표로 구분, 순서대로)
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
# 답변 속도를 위해 생각 단계를 줄임 (LOW 권장)
GEMINI_THINKING_LEVEL=LOW

# 이메일 (console = 터미널에 출력만, smtp = 실제 발송)
EMAIL_MODE=console
# Gmail 사용 시: 2단계 인증을 켠 뒤 "앱 비밀번호"(16자리)를 발급받아 넣으세요. 일반 비밀번호는 동작하지 않습니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=AI Campus Assistant

# 마감 알림 메일 (내일·오늘 마감인 과제를 하루 한 번)
REMINDERS_ENABLED=1
REMINDER_HOUR=9
APP_TIMEZONE=Asia/Seoul
